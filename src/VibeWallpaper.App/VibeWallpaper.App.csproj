<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>annotations</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <Target Name="BuildMediaProbePayload">
    <MSBuild
        Projects="$(MSBuildProjectDirectory)\..\VibeWallpaper.MediaProbe\VibeWallpaper.MediaProbe.csproj"
        Targets="Build"
        Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="MediaProbeTarget" />
    </MSBuild>
    <ItemGroup>
      <MediaProbePayload Include="@(MediaProbeTarget)" />
      <MediaProbePayload Include="@(MediaProbeTarget->'%(RootDir)%(Directory)%(Filename).exe')" />
      <MediaProbePayload Include="@(MediaProbeTarget->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <MediaProbePayload Include="@(MediaProbeTarget->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>
  </Target>
  <Target Name="CopyMediaProbePayload" AfterTargets="Build" DependsOnTargets="BuildMediaProbePayload">
    <Copy SourceFiles="@(MediaProbePayload)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMediaProbePayloadToPublish" AfterTargets="Publish" DependsOnTargets="BuildMediaProbePayload">
    <Copy SourceFiles="@(MediaProbePayload)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\VibeWallpaper.Engine\VibeWallpaper.Engine.csproj" />
    <ProjectReference Include="..\VibeWallpaper.MediaProbe\VibeWallpaper.MediaProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>VibeWallpaper.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
