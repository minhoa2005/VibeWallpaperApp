<Page
    x:Class="VibeWallpaper.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:VibeWallpaper.App.ViewModels">
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <InfoBar
        x:Name="LibraryNotice"
        Grid.Row="0"
        AutomationProperties.AutomationId="LibraryNotice"
        CloseButtonClick="LibraryNotice_CloseButtonClick"
        IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=OneWay}"
        Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
        Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="180" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <AutoSuggestBox
          AutomationProperties.AutomationId="LibrarySearchBox"
          PlaceholderText="Tìm wallpaper"
          Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox
          Grid.Column="1"
          AutomationProperties.AutomationId="LibraryKindFilter"
          DisplayMemberPath="Label"
          ItemsSource="{x:Bind ViewModel.KindFilters, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedKindFilter, Mode=TwoWay}" />
      <ComboBox
          Grid.Column="2"
          AutomationProperties.AutomationId="LibraryStatusFilter"
          DisplayMemberPath="Label"
          ItemsSource="{x:Bind ViewModel.StatusFilters, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}" />
      <Button
          Grid.Column="3"
          AutomationProperties.AutomationId="ImportVideoButton"
          Click="ImportVideoButton_Click"
          Content="Thêm video"
          IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBooleanConverter}}" />
      <Button
          Grid.Column="4"
          AutomationProperties.AutomationId="ImportWebButton"
          Click="ImportWebButton_Click"
          Content="Thêm web"
          IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBooleanConverter}}" />
    </Grid>

    <GridView
        Grid.Row="2"
        AutomationProperties.AutomationId="LibraryGrid"
        IsItemClickEnabled="False"
        ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
        SelectionMode="None">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="viewModels:LibraryItemViewModel">
          <Border
              Width="420"
              Margin="0,0,8,8"
              Padding="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{ThemeResource ControlCornerRadius}">
            <StackPanel Spacing="8">
              <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name, Mode=OneTime}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind KindLabel, Mode=OneTime}" />
                <TextBlock
                    AutomationProperties.Name="{x:Bind AutomationStatusText, Mode=OneTime}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind StatusLabel, Mode=OneTime}" />
              </StackPanel>
              <TextBlock
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="{x:Bind MetadataSummary, Mode=OneTime}"
                  TextWrapping="Wrap" />
              <TextBlock
                  AutomationProperties.Name="Đường dẫn nguồn wallpaper"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="{x:Bind SourcePath, Mode=OneTime}"
                  TextTrimming="CharacterEllipsis"
                  TextWrapping="NoWrap" />
              <ToggleSwitch
                  x:Name="NetworkToggle"
                  AutomationProperties.AutomationId="{x:Bind NetworkAutomationId, Mode=OneTime}"
                  AutomationProperties.Name="Cho phép web wallpaper truy cập mạng"
                  Header="Truy cập mạng"
                  IsOn="{x:Bind NetworkEnabled, Mode=OneTime}"
                  Toggled="NetworkToggle_Toggled"
                  x:Load="{x:Bind IsWeb, Mode=OneTime}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="{x:Bind UseAutomationId, Mode=OneTime}"
                    AutomationProperties.Name="Dùng wallpaper"
                    Click="UseWallpaperButton_Click"
                    Content="Dùng"
                    IsEnabled="{x:Bind CanUse, Mode=OneTime}" />
                <Button
                    AutomationProperties.AutomationId="{x:Bind RevalidateAutomationId, Mode=OneTime}"
                    AutomationProperties.Name="Kiểm tra lại wallpaper"
                    Click="RevalidateButton_Click"
                    Content="Kiểm tra lại"
                    IsEnabled="{x:Bind CanRevalidate, Mode=OneTime}" />
                <Button
                    AutomationProperties.AutomationId="{x:Bind OpenLocationAutomationId, Mode=OneTime}"
                    AutomationProperties.Name="Mở vị trí nguồn"
                    Click="OpenLocationButton_Click"
                    Content="Mở thư mục" />
                <Button
                    AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneTime}"
                    AutomationProperties.Name="Xóa khỏi thư viện"
                    Click="RemoveButton_Click"
                    Content="Xóa" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>

    <ProgressRing
        Grid.Row="2"
        Width="36"
        Height="36"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        AutomationProperties.AutomationId="LibraryBusyIndicator"
        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
  </Grid>
</Page>
